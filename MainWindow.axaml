
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MiPresentacion.MainWindow"
        Title="MiPresentacion"
        Width="450"
        Height="550"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="25" Spacing="12">

        <TextBlock Text="Mi primera aplicación gráfica"
                   FontSize="23"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>

        <TextBlock Text="Nombre:"/>
        <TextBox x:Name="Nombre"
                 Watermark="Ingrese su nombre"/>

        <TextBlock Text="Apellido:"/>
        <TextBox x:Name="Apellido"
                 Watermark="Ingrese su apellido"/>

        <TextBlock Text="Edad:"/>
        <TextBox x:Name="Edad"
                 Watermark="Ingrese su edad"/>

        <Button Content="Presentarme"
                Click="Presentarme_Click"
                Margin="0,10,0,0"/>

        <Button Content="Limpiar"
                Click="Limpiar_Click"/>

        <Button Content="Cambiar saludo"
                Click="CambiarSaludo_Click"/>

        <TextBlock x:Name="Mensaje"
                   Text="Aquí aparecerá tu presentación."
                   TextWrapping="Wrap"
                   FontSize="15"
                   Margin="0,20,0,0"
                   HorizontalAlignment="Center"/>

    </StackPanel>
</Window>
